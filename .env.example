# ============================================================
# MsNhu English — Template cấu hình
# Copy file này thành .env rồi điền giá trị thật
# File .env.example được commit vào git (không có secret)
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=msnhu_english
POSTGRES_USER=msnhu_user
POSTGRES_PASSWORD=your_strong_db_password

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=your_strong_redis_password

# ── JWT (tối thiểu 32 ký tự) ─────────────────────────────────
JWT_KEY=your_random_32_chars_min_jwt_secret

# ── SMTP ─────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your@gmail.com
SMTP_FROM_NAME=MsNhu English

# ── URLs ─────────────────────────────────────────────────────
FRONTEND_URL=https://yourdomain.com
HTTP_PORT=80

# ── Cloudinary ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Cổng thanh toán (Payment Gateways) ────────────────────────
# 1. PayOS (VietQR tự động gạch nợ - Khuyến nghị dùng chính)
# Đăng ký & lấy key tại: https://payos.vn/
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# 2. VNPay (Dự phòng thẻ Visa/Master/ATM nội địa)
# Đăng ký & lấy key tại: https://sandbox.vnpayment.vn/
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
